{
  "arch": "kite_trunk",
  "joint_encoder": "slot",
  "tree_bias": false,
  "frame": "world",
  "kite_ckpt": "SET_ME: <KITE>/checkpoints/decoder/release.pt",
  "kite_root": "SET_ME: path to the KITE checkout",
  "kite_init_head": "allegro_right",
  "batch_size": 512,
  "lr": 0.0003,
  "out_dir": "${GETKITE_RUNS}/kite_trunk_slot_oracle",
  "regime": "kite_code",
  "holdout_frac": 0.1,
  "train_split": "test_geometry+test_joint_count+test_finger_subset+test_combined",
  "train_part": "fit",
  "eval_splits": [
    "test_geometry@holdout",
    "test_joint_count@holdout",
    "test_finger_subset@holdout",
    "test_combined@holdout"
  ],
  "kite_freeze": [
    "unpacker",
    "hand_proj",
    "scene",
    "action"
  ]
}
